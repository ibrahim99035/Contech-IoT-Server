meta {
  name: Update Name
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/apartments-handler/apartments/update-name
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {"id": "{{apartmentId}}", "name": "Manual Updated Apartment"}
}
