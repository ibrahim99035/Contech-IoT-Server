meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/device-handler/devices/create
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {"name": "Manual Test Device", "room": "{{roomId}}", "type": "esp32"}
}
