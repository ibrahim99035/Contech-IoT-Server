meta {
  name: Update Password
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/auth/update-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {"currentPassword": "Manual@123456", "newPassword": "Manual@654321"}
}
