# Contech IoT Server — Environment Example
# Copy to `.env` and fill in real values. `.env` is git-ignored.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development            # development | production | deployment
LOG_LEVEL=debug                 # debug | info | warn | error
# LOG_DIR=logs                  # optional
# LOG_TO_CONSOLE=true           # optional
# LOG_TO_FILE=true              # optional

# ── Database (production replica set) ───────────────────────────────────────
# directConnection=true is required when connecting from outside the docker network,
# because the replica set advertises its internal hostname.
MONGODB_URI=mongodb://admin:<password>@88.222.220.235:27017/contech?authSource=admin&directConnection=true

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=<jwt-secret>
JWT_EXPIRES_IN=6d

# ── Redis (BullMQ task scheduler) ───────────────────────────────────────────
REDIS_HOST=88.222.220.235
REDIS_PORT=6380
REDIS_PASSWORD=<redis-password>
REDIS_URL=redis://:<redis-password>@88.222.220.235:6380

# ── MQTT (production broker) ────────────────────────────────────────────────
# NOTE: quote values containing '#' (dotenv treats '#' as a comment start).
MQTT_BROKER_URL=mqtt://88.222.220.235:1884
MQTT_USERNAME=contech
MQTT_PASSWORD="@#/123Work@#/"

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_USER=<smtp-user>
EMAIL_PASS=<smtp-password>

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL_TOKEN=<frontend-token-url>
FRONTEND_URL=<frontend-url>

# ── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_ACTIONS_CLIENT_ID=<google-actions-client-id>
GOOGLE_ACTIONS_CLIENT_SECRET=<google-actions-client-secret>

# ── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>