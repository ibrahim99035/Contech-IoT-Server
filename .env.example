# Contech IoT Server — Environment Example
# Copy to `.env` and fill in real values. `.env` is git-ignored.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development            # development | production | deployment
LOG_LEVEL=debug                 # debug | info | warn | error
# LOG_DIR=logs                  # optional
# LOG_TO_CONSOLE=true           # optional
# LOG_TO_FILE=true              # optional

# ── Database (production replica set) ───────────────────────────────────────
# Inside Docker use the Compose service name; MongoDB is bound to 127.0.0.1 on
# the host, so the public IP no longer reaches it.
# directConnection=true is only needed when connecting from outside the network,
# because the replica set advertises its internal hostname.
MONGODB_URI=mongodb://admin:<password>@mongodb:27017/contech?authSource=admin
# Root credentials used by the mongo container + mongo-express (compose vars).
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=<mongo-root-password>

# ── Backups ─────────────────────────────────────────────────────────────────
# scripts/install-backup-cron.sh runs scripts/backup-mongo.sh daily at 02:15.
# Archives land in mongodb/backups/ (git-ignored).
BACKUP_KEEP=14                    # number of daily archives to retain
# BACKUP_REMOTE=s3:my-bucket/contech   # optional rclone target for offsite copy

# ── MongoDB Express (loopback DB admin UI) ──────────────────────────────────
# docker-compose publishes mongo-express on 127.0.0.1:8081 only, but it still
# requires basic auth, so a non-empty password is mandatory.
MONGO_EXPRESS_USERNAME=contech_admin
MONGO_EXPRESS_PASSWORD=<mongo-express-password>

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=<jwt-secret>
JWT_EXPIRES_IN=6d

# ── Redis (BullMQ task scheduler) ───────────────────────────────────────────
# Inside Docker use the Compose service name and internal port; Redis is bound to
# 127.0.0.1 on the host, so REDIS_URL must NOT point at the public IP (that was
# why the API logged "Connection timeout" and fell back to in-memory).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
REDIS_URL=redis://:<redis-password>@redis:6379
# Set true to refuse to run without Redis instead of degrading to in-memory
# task scheduling (which silently drops queued jobs).
# REDIS_REQUIRED=true

# ── MQTT (production broker) ────────────────────────────────────────────────
# Docker Compose deployments should use the service name: mqtt://mqtt-broker:1884.
# The public URL below is for running the server outside the Compose network.
# NOTE: quote values containing '#' (dotenv treats '#' as a comment start).
MQTT_BROKER_URL=mqtt://88.222.220.235:1884
MQTT_USERNAME=contech
MQTT_PASSWORD=<mqtt-password>

# Feature switches for side-effecting subsystems. Set false when running locally
# against shared production infrastructure so a dev server neither subscribes to
# production MQTT topics nor starts BullMQ workers that fire real device tasks.
# Both default to true when unset.
MQTT_ENABLED=false
SCHEDULER_ENABLED=false

# Start an in-process Aedes broker when no external broker answers. Intended for
# local development only and refused in production: an embedded broker silently
# captures the API's subscriptions while real devices stay on the real broker.
# MQTT_ALLOW_EMBEDDED=true

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_USER=<smtp-user>
EMAIL_PASS=<smtp-password>

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL_TOKEN=<frontend-token-url>
FRONTEND_URL=<frontend-url>

# ── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_ACTIONS_CLIENT_ID=<google-actions-client-id>
GOOGLE_ACTIONS_CLIENT_SECRET=<google-actions-client-secret>

# ── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>